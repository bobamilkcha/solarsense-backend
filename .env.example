ENVIRONMENT=local
PROJECT_NAME="Insight Backend"
DOMAIN=localhost
HOST=0.0.0.0
PORT=8000

BACKEND_CORS_ORIGINS=["*"]
RATE_LIMITER_ENABLED=false

SECRET_KEY=secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SAMESITE=lax

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=insight_db
SQL_ECHO=false

MQTT_BROKER_HOST=your-emqx-cloud-host.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_USE_TLS=true

OBJECT_STORAGE_DIR=./data/object_storage

# Reference cell short-circuit current at 1000 W/m^2, in amps (placeholder until calibrated)
REFERENCE_CELL_ISC_A=0.22

LOG_LEVEL=DEBUG
LOG_HANDLERS=stream
