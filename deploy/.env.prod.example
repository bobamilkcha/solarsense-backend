# Copy to .env on the server (same folder as docker-compose.prod.yml) and fill in.
ENVIRONMENT=production
PROJECT_NAME="SolarSense Backend"

# Your DuckDNS name, e.g. solarsense-fyp.duckdns.org (no https://). Caddy gets the HTTPS cert for it.
DOMAIN=yourname.duckdns.org

# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changethis
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# The frontend calls /api/..., so the refresh cookie must be scoped to /api/auth.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAMESITE=lax

# Same origin, so no CORS origins are needed.
BACKEND_CORS_ORIGINS=
RATE_LIMITER_ENABLED=false

# DATABASE_HOST/PORT are set by the compose file. Pick a strong password (letters+digits is fine).
DATABASE_USER=postgres
DATABASE_PASSWORD=changethis
DATABASE_NAME=solarsense

# EMQX Cloud (same values you use locally)
MQTT_BROKER_HOST=your-emqx-cloud-host.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_USE_TLS=true

SHUNT_OHMS=10.0
ISC_STC_MA=220.0

LOG_LEVEL=INFO
LOG_HANDLERS=stream

# Only for the free "run on my own PC" mode (docker-compose.local.yml): from https://dashboard.ngrok.com
# NGROK_DOMAIN is your free static domain without https://, e.g. something.ngrok-free.dev
# (set DOMAIN above to the same value).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
